# Database / cache / runner (docker-compose already provides working defaults)
DATABASE_URL=postgresql+asyncpg://interviewos:interviewos@db:5432/interviewos
REDIS_URL=redis://redis:6379/0
RUNNER_URL=http://runner:8001
CORS_ORIGINS=http://localhost:5173
# Host port publishing the compose backend (127.0.0.1:PORT:8000). Change it
# when another local service already owns 8000 — Playwright reads the same
# variable for its health probe and vite API proxy
# (`BACKEND_HOST_PORT=8020 npx playwright test`). Default: 8000.
BACKEND_HOST_PORT=8000

# Optional LLM adapter: OpenAI-compatible / DeepSeek-compatible / local vLLM.
# Leave all three blank to use InterviewOS offline scoring/follow-up mode.
# Examples of compatible providers include a local vLLM endpoint or a hosted provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# v0.8 authentication & token lifecycle
# AUTH_SECRET must be a long random string; rotating it invalidates every session.
AUTH_SECRET=replace-with-a-long-random-secret
# Short-lived access token; the frontend silently refreshes it via the
# refresh token when it expires.
AUTH_TOKEN_MINUTES=30
# Refresh token lifetime in days. Refresh tokens rotate on every use and are
# revoked on logout / all-devices logout / password change.
AUTH_REFRESH_DAYS=14

# v1.0 Git provider OAuth (GitHub / Gitee) — all optional.
# Leave client id/secret blank to keep the anonymous public-repo sync path
# only; nothing else degrades when OAuth is unconfigured.
# Register an OAuth app and set its callback URL to <OAUTH_REDIRECT_BASE>/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=
# Master secret encrypting provider access tokens at rest (stdlib HMAC-CTR+EtM).
# Rotating it invalidates every stored token — users must disconnect and
# re-authorize. Falls back to AUTH_SECRET when blank.
OAUTH_ENCRYPTION_KEY=
# Public frontend origin the providers redirect back to.
OAUTH_REDIRECT_BASE=http://localhost:5173

# v1.0 Observability
# LOG_FORMAT: json (default, one object per line for log collectors) or
# text (human-readable local development).
LOG_FORMAT=json
LOG_LEVEL=INFO
# Optional Sentry DSN. Blank = zero overhead, no third-party calls; when set,
# install the extra with `uv add sentry-sdk` (it is intentionally optional).
SENTRY_DSN=
