# Normalize all text files to LF in the repository; working copy follows
# each platform's native convention (CRLF on Windows via autocrlf).
* text=auto

# Shell scripts must stay LF for Linux containers / CI
*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
